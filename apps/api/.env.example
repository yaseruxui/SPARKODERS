# Local SQLite file; see prisma.config.ts to switch to Postgres.
DATABASE_URL="file:./prisma/dev.db"

PORT=4000
# Where the admin dashboard runs (CORS + links in invitation emails).
ADMIN_URL=http://localhost:5173
# Long random string signing the dashboard session cookie.
JWT_SECRET=change-me-to-a-long-random-string
# The site posts its contact form to /public/contact with header `x-contact-key: <this>`.
CONTACT_WEBHOOK_KEY=change-me-too
# Optional: `npm run admin:create` reads these when no arguments are given.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# This API's public origin (media URLs) and where uploads are stored.
PUBLIC_URL=http://localhost:4000
UPLOADS_DIR=uploads
# The public site: refreshed after each save, and the source of the one-time import.
SITE_URL=http://localhost:3000
SITE_REVALIDATE_SECRET=

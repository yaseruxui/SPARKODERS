# Canonical origin for metadata, sitemap and hreflang
NEXT_PUBLIC_SITE_URL=https://sparkoders.com
# The dashboard API's contact endpoint ({API}/public/contact) and its shared key.
# Unset → the form asks visitors to email instead.
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_KEY=
# Brand font: "default" (Alexandria + IBM Plex) or "thmanyah" (needs licensed files in public/fonts/thmanyah/)
NEXT_PUBLIC_BRAND_FONT=default
# The dashboard API: edited content is read from it, and it refreshes the site after each save.
CMS_API_URL=
# Same value as SITE_REVALIDATE_SECRET in apps/api.
REVALIDATE_SECRET=
